{
  // OpenCode V2 project config for FreeProxyAPI.
  // Copy this file to the project root as `opencode.jsonc`.
  "$schema": "https://opencode.ai/config.json",
  "model": "freeproxy/auto",
  "providers": {
    "freeproxy": {
      "name": "FreeProxyAPI",
      "env": ["FREEPROXY_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "headerTimeout": 660000,
        "chunkTimeout": 660000
      },
      "compatibility": {
        "maxTokensField": "max_tokens",
        "streamUsage": false
      },
      "models": {
        "auto": {
          "name": "Auto (GLM → Qwen → DeepSeek)",
          "modelID": "auto",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "freeform": []
          },
          "limit": { "context": 128000, "output": 8192 }
        },
        "fast": {
          "name": "Fast (GLM Flash → Qwen Plus)",
          "modelID": "fast",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "freeform": []
          },
          "limit": { "context": 128000, "output": 8192 }
        },
        "coding": {
          "name": "Coding (Qwen 3.7 Plus → GLM → DeepSeek)",
          "modelID": "coding",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "freeform": []
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": { "context": 128000, "output": 8192 }
        },
        "reasoning": {
          "name": "Reasoning (DeepSeek → GLM → Qwen)",
          "modelID": "reasoning",
          "capabilities": {
            "tools": true,
            "reasoning": { "supported": true },
            "input": ["text"],
            "output": ["text"],
            "freeform": []
          },
          "compatibility": {
            "reasoningField": "reasoning_content",
            "requireReasoning": true
          },
          "limit": { "context": 128000, "output": 8192 }
        },
        "vision": {
          "name": "Vision (Qwen 3.8 Max → GLM V)",
          "modelID": "vision",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "freeform": []
          },
          "limit": { "context": 128000, "output": 8192 }
        },
        "glm-flash": {
          "name": "GLM 5.3 Flash",
          "modelID": "glm/glm-5.3-flash",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "freeform": []
          },
          "limit": { "context": 128000, "output": 8192 }
        },
        "glm": {
          "name": "GLM 4.7",
          "modelID": "glm/glm-4.7",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "freeform": []
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": { "context": 128000, "output": 8192 }
        },
        "qwen-max": {
          "name": "Qwen 3.7 Max",
          "modelID": "qwen/qwen3.7-max",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "freeform": []
          },
          "limit": { "context": 128000, "output": 8192 }
        },
        "qwen-plus": {
          "name": "Qwen 3.7 Plus",
          "modelID": "qwen/qwen3.7-plus",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "freeform": []
          },
          "limit": { "context": 128000, "output": 8192 }
        },
        "deepseek-chat": {
          "name": "DeepSeek Chat",
          "modelID": "deepseek/deepseek-chat",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "freeform": []
          },
          "limit": { "context": 128000, "output": 8192 }
        },
        "deepseek-reasoner": {
          "name": "DeepSeek Reasoner",
          "modelID": "deepseek/deepseek-reasoner",
          "capabilities": {
            "tools": true,
            "reasoning": { "supported": true },
            "input": ["text"],
            "output": ["text"],
            "freeform": []
          },
          "compatibility": {
            "reasoningField": "reasoning_content",
            "requireReasoning": true
          },
          "limit": { "context": 128000, "output": 8192 }
        }
      }
    }
  }
}
