{
  "version": 1,
  "providers": [
    {
      "id": "glm",
      "name": "GLM / Z.AI native (in-process)",
      "base_url": "http://glm.native",
      "api_key": "",
      "auth_mode": "none",
      "auth_required": false,
      "native": "glm",
      "prefix": "glm",
      "enabled": true,
      "models": [
        "glm-5.3-flash",
        "glm-5.3",
        "glm-5.2",
        "GLM-5.1",
        "GLM-5-Turbo",
        "GLM-5v-Turbo",
        "glm-4.7"
      ],
      "default_model": "glm-5.3-flash",
      "models_path": "/v1/models",
      "chat_path": "/v1/chat/completions",
      "max_rpm": 6,
      "max_requests_per_day": 300,
      "max_concurrency": 1,
      "queue_timeout_seconds": 60,
      "timeout_seconds": 600,
      "max_retries": 0,
      "session_header": false,
      "supports_tools": true,
      "inject_max_tokens": true,
      "extra_headers": {}
    },
    {
      "id": "qwen",
      "name": "Qwen Chat native (in-process)",
      "base_url": "http://qwen.native",
      "api_key": "",
      "auth_mode": "none",
      "auth_required": false,
      "native": "qwen",
      "prefix": "qwen",
      "enabled": true,
      "models": [
        "qwen3.8-max",
        "qwen3.7-max",
        "qwen3.7-plus"
      ],
      "default_model": "qwen3.7-max",
      "models_path": "/v1/models",
      "chat_path": "/v1/chat/completions",
      "max_rpm": 6,
      "max_requests_per_day": 300,
      "max_concurrency": 1,
      "queue_timeout_seconds": 60,
      "timeout_seconds": 600,
      "max_retries": 0,
      "session_header": false,
      "supports_tools": true,
      "inject_max_tokens": true,
      "extra_headers": {}
    },
    {
      "id": "deepseek",
      "name": "DeepSeek native (in-process)",
      "base_url": "http://deepseek.native",
      "api_key": "",
      "auth_mode": "none",
      "auth_required": false,
      "native": "deepseek",
      "prefix": "deepseek",
      "enabled": true,
      "models": [
        "deepseek-chat",
        "deepseek-reasoner",
        "deepseek-chat-search",
