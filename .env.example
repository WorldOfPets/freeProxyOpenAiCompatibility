# FreeProxyAPI gateway settings.
# Copy to .env and change at least FP_API_KEYS.
# All variables use the FP_ prefix.

# --- Network -----------------------------------------------------------------
FP_HOST=127.0.0.1
FP_PORT=8080
FP_SERVER_LIMIT_CONCURRENCY=128
FP_ENVIRONMENT=local

# --- Client authentication ---------------------------------------------------
# Comma-separated list of at least 16 characters per key. Clients send one as
# "Authorization: Bearer <key>" or "X-API-Key: <key>".
# Generate one with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
FP_API_KEYS=replace-with-a-long-random-key-0123456789
# Keep true only for a loopback-only development instance.
# If FP_API_KEYS is empty and this is false, startup fails.
FP_ALLOW_ANONYMOUS=false

# Optional separate key for /admin/*. If empty, admin endpoints are
# available only from loopback clients.
FP_ADMIN_API_KEY=

# --- Client rate limits ------------------------------------------------------
# Requests per minute per API key (or per anonymous client IP).
FP_CLIENT_RPM=30
# Simultaneous in-flight requests per API key.
FP_CLIENT_MAX_CONCURRENCY=2
# Requests per UTC day per API key. 0 disables the daily limit.
FP_CLIENT_DAILY_REQUESTS=1000
# Requests per minute across the whole gateway.
FP_GLOBAL_RPM=60
FP_GLOBAL_MAX_CONCURRENCY=8
FP_GLOBAL_QUEUE_TIMEOUT_SECONDS=10

# --- Payload / generation limits --------------------------------------------
FP_MAX_BODY_BYTES=8000000
FP_BODY_READ_TIMEOUT_SECONDS=30
FP_MAX_UPSTREAM_BYTES=16000000
FP_MAX_OUTPUT_TOKENS=8192
FP_DEFAULT_MAX_TOKENS=4096
# When true, an unknown bare model is rejected instead of being sent to the
# default provider. Namespaced models such as "glm/glm-4.7" are always allowed.
FP_STRICT_MODELS=false

# --- Upstreams ---------------------------------------------------------------
FP_PROVIDERS_FILE=config/providers.json
FP_MODEL_DISCOVERY_TTL_SECONDS=300
FP_MODEL_DISCOVERY_TIMEOUT_SECONDS=5
FP_REQUEST_CONNECT_TIMEOUT_SECONDS=10

# --- Browser-assisted upstream auth -----------------------------------------
# `uv run freeproxy-auth login ...` writes tokens here (never commit this).
# The gateway and the auth CLI share this setting. The legacy name
# FP_AUTH_STORE is still accepted, but FP_AUTH_STORE_PATH wins when both are set.
FP_AUTH_STORE_PATH=secrets/tokens.json
FP_AUTH_BROWSER_DIR=secrets/browser
FP_AUTH_BROWSER_CHANNEL=chrome
# Optional explicit Chrome/Edge path; empty = auto-detect.
FP_AUTH_CHROME_PATH=
FP_AUTH_TIMEOUT_SECONDS=600
# --- Native provider settings ------------------------------------------------
# Qwen runs a real browser in-process; install Chrome or run
# `uv run playwright install chromium`. Headless is the default.
FP_QWEN_HEADLESS=true
# Aliyun captcha SDK credentials used by the built-in GLM captcha generator.
# Required for both InitCaptchaV3 and VerifyCaptchaV3; never commit real values.
# Ask the GLM-Free-API reference project operator or use your own Aliyun
# captcha-enabled account.
FP_ALIYUN_CAPTCHA_ACCESS_KEY=
FP_ALIYUN_CAPTCHA_SECRET_KEY=
# Optional: playbook of harvested GLM device tokens (tokens.sqlite produced by
# the legacy collector). Loaded from .env by the running gateway; when set it
# takes precedence over the built-in fallback paths. Leave blank to use them.
FP_GLM_TOKENS_DB=secrets/glm-tokens.sqlite

# Legacy checkout paths are only used by `freeproxy-auth export`; native
# providers do not need them at runtime.
FP_DEEPSEEK_REPO=../FreeDeepseekAPI
FP_QWEN_REPO=../FreeQwenApi
FP_GLM_REPO=../GLM-Free-API

# --- Observability -----------------------------------------------------------
FP_LOG_LEVEL=INFO
FP_LOG_FORMAT=json
# Empty means no CORS middleware. Example: http://localhost:3000,http://127.0.0.1:5173
FP_CORS_ORIGINS=
FP_SHUTDOWN_TIMEOUT_SECONDS=15
